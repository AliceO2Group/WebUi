{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "[ilg] run dev",
            "request": "launch",
            "runtimeArgs": [
                "run-script",
                "dev"
            ],
            "localRoot": "${workspaceFolder}/InfoLogger/",
            "runtimeExecutable": "npm",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "outputCapture": "std",
            "type": "node",
            "windows": {
                "localRoot": "${workspaceFolder}\\InfoLogger\\"
            }
        },
        {
            "name": "Launch firefox",
            "type": "firefox",
            "request": "attach",
            "url": "http://localhost:8080/",
            "webRoot": "${workspaceFolder}",
            "pathMappings": [
                {
                    "url": "http://localhost:8080/",
                    "path": "${workspaceFolder}/QualityControl/public/"
                }
            ]
        }
    ]
}
