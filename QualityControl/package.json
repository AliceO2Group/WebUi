{
  "name": "@aliceo2/qc",
  "version": "3.9.1",
  "description": "O2 Quality Control Web User Interface",
  "author": "George Raduta",
  "contributors": [
    "Vladimir Kosmala",
    "Adam Wegrzynek"
  ],
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AliceO2Group/WebUi.git"
  },
  "engines": {
    "node": ">= 20.x"
  },
  "type": "module",
  "homepage": "https://alice-o2-project.web.cern.ch/",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon --watch index.js --watch lib --watch config.js index.js",
    "lint": "./node_modules/.bin/eslint --config eslint.config.js lib public",
    "coverage-lcov": "node --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=coverage.lcov test/test-index.js",
    "coverage-local": "node --test --experimental-test-coverage --test-reporter=spec test/test-index.js",
    "test": "node --test test/test-index.js"
  },
  "files": [
    "common/",
    "lib/",
    "public/",
    "index.js"
  ],
  "dependencies": {
    "@aliceo2/web-ui": "2.7.3",
    "joi": "17.13.3",
    "jsroot": "7.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@stylistic/eslint-plugin-js": "^2.13.0",
    "eslint": "^9.18.0",
    "eslint-plugin-jsdoc": "^50.6.0",
    "globals": "^15.14.0",
    "nock": "^13.5.0",
    "puppeteer": "^24.0.0",
    "sinon": "^19.0.2"
  },
  "bundleDependencies": [
    "@aliceo2/web-ui",
    "jsroot",
    "joi"
  ]
}
