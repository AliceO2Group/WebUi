{
  "name": "central-system",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "description": "A NodeJS backend for the token issuer within ALICE O2",
  "scripts": {
    "build": "tsc",
    "watch:ts": "tsc -w",
    "watch:node": "nodemon --watch dist --ext js,json --exec \"node index.js\"",
    "dev": "npm run build && concurrently -k \"npm:watch:*\"",
    "start": "node index.js",
    "test": "jest --runInBand",
    "docker:up": "cd ../.. && docker compose -f docker-compose.yml up",
    "docker:down": "cd ../.. && docker compose -f docker-compose.yml down"
  },
  "dependencies": {
    "@aliceo2/web-ui": "^2.8.4",
    "crypto": "^1.0.1",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.2",
    "@grpc/grpc-js": "^1.13.4",
    "@grpc/proto-loader": "^0.7.15"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^20.4.2",
    "concurrently": "^9.0.1",
    "jest": "^30.0.5",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
