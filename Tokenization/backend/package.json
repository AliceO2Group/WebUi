{
  "name": "@aliceo2/tokenization-backend",
  "version": "0.0.1",
  "description": "A NodeJS backend for the token issuer within ALICE O2",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "postinstall": "npm --prefix central-system install",
    "build": "npm --prefix central-system run build",
    "watch:ts": "npm --prefix central-system run watch:ts",
    "watch:node": "nodemon --watch index.js --watch central-system/dist --ext js,json --exec \"node index.js\"",
    "dev": "npm run build && concurrently -k \"npm:watch:*\"",
    "start": "node index.js",
    "test": "jest --runInBand",
    "docker-dev:up": "cd .. && docker compose -f docker-compose.dev.yml up -d  && docker compose -f docker-compose.yml up -d",
    "docker-dev:down": "cd .. && docker compose -f docker-compose.yml -f docker-compose.dev.yml down"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AliceO2Group/WebUi.git"
  },
  "author": "",
  "license": "GPL-3.0",
  "homepage": "https://github.com/AliceO2Group/WebUi#readme",
  "dependencies": {
    "@aliceo2/web-ui": "^2.8.4",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.9.2",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.0.1",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5"
  }
}
